# ─── Server ───
PORT=3000
NODE_ENV=development
API_KEY=tn_dev_key_2025

# ─── Database ───
DB_HOST=localhost
DB_PORT=3306
DB_USER=tradeneuron
DB_PASSWORD=tn_pass_2025
DB_NAME=tradeneuron
DB_CONNECTION_LIMIT=10

# ─── Yahoo Finance ───
YAHOO_THROTTLE_MS=300
YAHOO_MAX_RETRIES=3
YAHOO_BACKOFF_BASE_MS=1000

# ─── Pipeline ───
CRON_SCHEDULE=30 16 * * 1-5
CRON_TIMEZONE=Asia/Kolkata
PIPELINE_TIMEOUT_MS=300000

# ─── Signals ───
MIN_CONFIDENCE=20
MIN_RISK_REWARD=2.0
MAX_ACTIVE_SIGNALS=10
MAX_SECTOR_SIGNALS=3
HOLDING_PERIOD_DAYS=10

# ─── Market Regime ───
VIX_THRESHOLD=20

# ─── Liquidity ───
MIN_LIQUIDITY_VOLUME=500000

# ─── Fundamentals ───
FUNDAMENTAL_CRON_SCHEDULE=0 18 * * 6
MAX_DEBT_TO_EQUITY=2.0
MIN_EPS_GROWTH_CONSECUTIVE_NEGATIVE=2
MIN_REVENUE_GROWTH_CONSECUTIVE_NEGATIVE=2
MAX_PROMOTER_PLEDGE_PCT=50

# ─── Sentiment ───
SENTIMENT_LOOKBACK_DAYS=7

# ─── Backtesting ───
SLIPPAGE_PCT=0.1
BROKERAGE_PCT=0.05

# ─── Position Sizing ───
TOTAL_CAPITAL_INR=1000000
RISK_PCT_PER_TRADE=1.0
MAX_POSITION_PCT=10

# ─── Adaptive Thresholds ───
ADAPTIVE_THRESHOLDS_ENABLED=true
ADAPTIVE_MIN_DATA_POINTS=30
ADAPTIVE_MIN_TRADES_PARTIAL=15
ADAPTIVE_MIN_TRADES_FULL=30
ADAPTIVE_PARTIAL_BLEND=0.3

# ─── Confidence Tiers ───
CONFIDENCE_TIER_HIGH=85
CONFIDENCE_TIER_NORMAL=75
CONFIDENCE_TIER_LOW=70

# ─── Smart Expiry ───
EXPIRED_MIN_PENALTY=-0.1
EXPIRED_MAX_PENALTY=-0.2
EXPIRED_MOVEMENT_THRESHOLD=1.0

# ─── Strategy Auto-Disable ───
STRATEGY_DISABLE_WIN_RATE=0.40
STRATEGY_DISABLE_MIN_TRADES=15
STRATEGY_REENABLE_WIN_RATE=0.50
STRATEGY_REENABLE_MIN_TRADES=20

# ─── Short Selling ───
MAX_POSITION_PCT_SHORT=5

# ─── Account Type ───
# ACCOUNT_TYPE: EQUITY (default) or FNO
# Set to FNO if you have a margin/derivatives account.
# When EQUITY: SHORT signals are generated but marked is_executable=false.
# When FNO: SHORT signals are executable via futures.
ACCOUNT_TYPE=EQUITY

# ─── VWAP Distance Thresholds ───
# Soft penalty: distance above this applies context-aware penalty (not flat -10).
# Hard reject: distance above this triggers hard rejection.
VWAP_DISTANCE_LONG_DEFAULT=2.0
VWAP_DISTANCE_BREAKOUT_LONG=3.5
VWAP_DISTANCE_SHORT_DEFAULT=2.0
VWAP_SOFT_PENALTY_LONG=2.0
VWAP_HARD_REJECT_LONG=5.0
VWAP_SOFT_PENALTY_SHORT=2.0
VWAP_HARD_REJECT_SHORT=5.0

# ─── VWAP Scoring ───
# Context-aware VWAP adjustments. Bonus when near, moderate penalty when stretched.
VWAP_SCORE_NEAR=3                    # bonus in scoring when price within 2% of VWAP
VWAP_SOFT_PENALTY_MODERATE=3         # penalty for 2-3.5% above VWAP without trend/breakout override
VWAP_SOFT_PENALTY_BELOW=8            # penalty when price below VWAP in weak stock
VWAP_BREAKOUT_RVOL_MIN=1.5           # RVOL required for breakout override of VWAP penalty
VWAP_TREND_OVERRIDE_ZONE=3.5         # above this %, only trend/breakout override avoids penalty
MIN_EMA50_SLOPE=0.5                  # minimum EMA50 slope to qualify as strong trend
VWAP_MAX_BONUS_CAP=10                # cap on total VWAP adjustment (+/-), raised for BREAKDOWN momentum scoring

# ─── Signal Frequency Controller ───
# Controls weekly trade frequency via Top-N candidate selection.
# When enabled, signals are pooled, ranked, and the best N are selected per day.
FREQUENCY_CONTROLLER_ENABLED=true
TARGET_WEEKLY_SIGNALS=10
MAX_SIGNALS_PER_DAY=3
POOL_MIN_CONFIDENCE=60
POOL_MIN_RISK_REWARD=1.5

# ─── Finnhub (Optional) ───
FINNHUB_API_KEY=

# ─── FinBERT Sentiment (Optional) ───
FINBERT_URL=http://127.0.0.1:8765

# ─── Telegram Alerts (Optional) ───
TELEGRAM_BOT_TOKEN=8255181757:AAHZpeDw0i5PrA2wybG7tL9vTHQW4psl00w
TELEGRAM_CHAT_ID=557260310

# ─── Logging ───
LOG_LEVEL=info
LOG_DIR=./logs

# ─── Improvements (execution plan) ───
MAX_SL_DISTANCE_PCT=6
CONFIDENCE_CALIBRATION_ENABLED=true
CALIBRATION_MIN_BUCKET_SAMPLES=20
CALIBRATION_PRIOR_WEIGHT=20
EARNINGS_BLACKOUT_ENABLED=true
SECTOR_TREND_PENALTY_ENABLED=true
SECTOR_TREND_PENALTY_POINTS=10
PORTFOLIO_RISK_CAP_ENABLED=true
MAX_PORTFOLIO_RISK_PCT=5
CORRELATION_POSITION_SCALING_ENABLED=true
REGIME_FREQUENCY_ENABLED=true
FREQ_MULT_BULLISH=1.0
FREQ_MULT_BEARISH=0.7
FREQ_MULT_SIDEWAYS=0.6
FREQ_MULT_HIGH_VOL=0
DRAWDOWN_RISK_SCALING_ENABLED=true
DRAWDOWN_THRESHOLD_HIGH=0.15
DRAWDOWN_THRESHOLD_MID=0.08
DRAWDOWN_SCALE_SEVERE=0.5
DRAWDOWN_SCALE_MODERATE=0.75
ENTRY_FRESHNESS_ENABLED=true
ENTRY_DEGRADED_DRIFT_PCT=2
DIRECTIONAL_EXPOSURE_ENABLED=true
MAX_SHORT_RISK_SHARE=0.7
FUTURES_SL_BUFFER_ENABLED=true
FUTURES_SL_BUFFER_FACTOR=1.003
VWMA_API_ALIAS_ENABLED=true
STRATEGY_PRUNING_AUTO_APPLY=false
STRATEGY_PRUNING_PROFIT_FACTOR_FLOOR=1.0
STRATEGY_PRUNING_EXPECTANCY_FLOOR=0
SHADOW_COMPARE_ENABLED=true
VALIDATION_MIN_SHADOW_DAYS=15
VALIDATION_MIN_SHADOW_OVERLAP_PCT=50
